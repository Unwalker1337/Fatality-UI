local Fatality = assert(loadstring(LIB_SOURCE))()
local Window = Fatality.new({Name = 'TEST', Keybind = '__TEST_MENU_KEY__'})
local rage = Window:AddMenu({Name = 'RAGE', AutoFill = false})
local legit = Window:AddMenu({Name = 'LEGIT', AutoFill = false})
local passed = 0
local function check(value, reason) assert(value, reason); passed += 1 end
local main = rage:AddTab({Name = 'General', Position = 'top'})
local weapons = rage:AddTab({Name = 'Weapons'})
local rifles = weapons:AddTab({Name = 'Rifles', Position = 'left'})
local pistols = weapons:AddTab({Name = 'Pistols'})
check(#Window.Menus == 2, 'Nested tabs must not create top-level menu entries')
check(rage.SelectedTab == main and main.Root.Visible and not weapons.Root.Visible, 'First child selected')
rifles:Select()
check(Window.MenuSelected == rage.State and rage.SelectedTab == weapons and weapons.SelectedTab == rifles, 'Deep selection activates ancestors')
check(rifles.Root.Visible and not pistols.Root.Visible, 'Deep child visibility')
for _, direction in ipairs({'top', 'bottom', 'left', 'right'}) do
    rage:SetTabsPosition(direction)
    check(rage.TabsPosition == direction, 'Tabs position ' .. direction)
    if direction == 'top' then check(rage.TabContent.Position.Y.Offset == 34, 'Top content inset') end
    if direction == 'bottom' then check(rage.TabsBar.AnchorPoint.Y == 1, 'Bottom bar anchored') end
    if direction == 'left' then check(rage.TabContent.Position.X.Offset == 118, 'Left content inset') end
    if direction == 'right' then check(rage.TabsBar.AnchorPoint.X == 1, 'Right bar anchored') end
end
check(not pcall(function() rage:SetTabsPosition('invalid') end), 'Invalid tab position rejected')
Window:SetVisible(false)
check(not rifles.Root.Visible, 'Hiding window hides nested content')
Window:SetVisible(true)
check(rifles.Root.Visible and not pistols.Root.Visible, 'Showing window restores selected nested content')
legit:Select()
check(not rage.Root.Visible and legit.Root.Visible, 'Switch top menu')
rifles.State.Activate()
check(Window.MenuSelected == rage.State and rifles.Root.Visible, 'Search activation supports nested tabs')

local section = rifles:AddSection({Name = 'AIM', Position = 'left'})
local callbacks, buttonFires = 0, 0
local toggle = section:AddToggle({Name = 'Enabled', Flag = 'enabled', Callback = function() callbacks += 1 end})
local action = section:AddButton({Name = 'Action', BindId = 'action', Callback = function() buttonFires += 1 end})
local disabled = section:AddToggle({Name = 'No bind', Bindable = false})
check(toggle.SetBind ~= nil and action.SetBind ~= nil and disabled.SetBind == nil, 'Context binds enabled for toggle/button and opt-out')
local input = services.UserInputService
local function press(key, processed)
    input.InputBegan:Fire({KeyCode = Enum.KeyCode[key], UserInputType = Enum.UserInputType.Keyboard}, processed or false)
end
local function lift(key)
    input.InputEnded:Fire({KeyCode = Enum.KeyCode[key], UserInputType = Enum.UserInputType.Keyboard})
end
toggle:SetBind({Key = 'Q', Mode = 'Toggle', Visible = true})
press('Q'); lift('Q')
check(toggle:GetValue() and callbacks == 1, 'Toggle bind enables')
check(Window.BindingState.List.Visible, 'Active bind appears in keybind list')
toggle:SetBind({Visible = false})
check(toggle:GetValue() and not Window.BindingState.List.Visible, 'Visible changes list membership only')
toggle:SetBind({Visible = true})
press('Q'); lift('Q')
check(not toggle:GetValue(), 'Second toggle press disables')
press('Q', true); lift('Q')
check(not toggle:GetValue(), 'Processed input ignored')
local focused = true
input.GetFocusedTextBox = function() return focused and {} or nil end
press('Q'); lift('Q')
check(not toggle:GetValue(), 'Typing does not activate binds')
focused = false
toggle:SetBind({Key = 'H', Mode = 'Hold'})
press('H')
check(toggle:GetValue(), 'Hold enables on keydown')
lift('H')
check(not toggle:GetValue(), 'Hold restores false state on release')
toggle:SetValue(true); press('H'); lift('H')
check(toggle:GetValue(), 'Hold preserves already enabled state')
toggle:SetValue(false); press('H'); input.WindowFocusReleased:Fire()
check(not toggle:GetValue(), 'Focus loss releases hold')
toggle:SetBind({Key = 'MouseButton3', Mode = 'Toggle'})
input.InputBegan:Fire({KeyCode = Enum.KeyCode.Unknown, UserInputType = Enum.UserInputType.MouseButton3}, false)
input.InputEnded:Fire({KeyCode = Enum.KeyCode.Unknown, UserInputType = Enum.UserInputType.MouseButton3})
check(toggle:GetValue(), 'Mouse binding')
toggle:ClearBind(); toggle:SetValue(false)
toggle:SetBind({Mode = 'Always'})
check(toggle:GetValue(), 'Always mode immediately enables toggle')
toggle:SetValue(false); services.RunService.Heartbeat:Fire(0.2)
check(toggle:GetValue(), 'Always mode reapplies enabled state')
toggle:ClearBind(); toggle:SetValue(false)
action:SetBind({Key = 'B', Mode = 'Toggle'})
press('B'); lift('B')
check(buttonFires == 1, 'Button toggle starts')
services.RunService.Heartbeat:Fire(0.2)
check(buttonFires == 2, 'Active button repeats')
action:SetBind({Visible = false})
services.RunService.Heartbeat:Fire(0.2)
check(buttonFires == 3, 'Visibility does not disable a button bind')
press('B'); lift('B'); services.RunService.Heartbeat:Fire(0.2)
check(buttonFires == 3, 'Second button toggle press stops repetition')
action:SetBind({Mode = 'Hold'})
press('B'); lift('B'); services.RunService.Heartbeat:Fire(0.2)
check(buttonFires == 4, 'Button hold stops on release')
action:ClearBind()

toggle.ElementFrame.AbsolutePosition, toggle.ElementFrame.AbsoluteSize = Vector2.new(10, 10), Vector2.new(180, 20)
action.ElementFrame.AbsolutePosition, action.ElementFrame.AbsoluteSize = Vector2.new(800, 800), Vector2.new(30, 20)
local mouse = Vector2.new(20, 15)
input.GetMouseLocation = function() return mouse end
input.InputBegan:Fire({KeyCode = Enum.KeyCode.Unknown, UserInputType = Enum.UserInputType.MouseButton2}, false)
local state = Window.BindingState
check(state.Popup.Visible and state.PopupEntry.Control == toggle, 'Right click opens target popup')
state.VisibleButton.MouseEnter:Fire()
check(state.Tooltip.Visible and state.Tooltip.Text == 'visible in keybinds list', 'Exact Visible tooltip')
state.VisibleButton.MouseLeave:Fire()
state.KeyButton.MouseButton1Click:Fire(); press('K'); lift('K')
check(toggle:GetBind().Key == 'K', 'Popup captures a key')
state.ModeButtons.Hold.MouseButton1Click:Fire()
check(toggle:GetBind().Mode == 'Hold', 'Popup mode choice')
state.VisibleButton.MouseButton1Click:Fire()
check(toggle:GetBind().Visible == false, 'Popup Visible checkbox')
state.KeyButton.MouseButton1Click:Fire(); press('Escape')
check(toggle:GetBind().Key == 'K' and not state.Listening, 'Escape cancels key capture')
state.KeyButton.MouseButton1Click:Fire(); press('Backspace')
check(toggle:GetBind().Key == nil and toggle:GetBind().Mode == 'Toggle', 'Backspace clears bind')
state.KeyButton.MouseButton1Click:Fire(); press('J'); lift('J')
mouse = Vector2.new(1100, 700)
input.InputBegan:Fire({KeyCode = Enum.KeyCode.Unknown, UserInputType = Enum.UserInputType.MouseButton1}, false)
check(not state.Popup.Visible, 'Outside click closes popup')

toggle:SetBindId('Aim enabled')
toggle:SetBindId('Aim enabled final')
toggle:SetBind({Key = 'X', Mode = 'Toggle', Visible = false})
Window:SetKeybindListVisible(false)
local snapshot = Window:GetFlagConfig()
check(snapshot.__FatalityBindings.Value.Type == 'Table', 'Bindings use native config format')
check(snapshot.__FatalityBindings.Value.Value.Bindings['Aim enabled final'].Key == 'X', 'Binding ID serialized')
toggle:ClearBind(); Window:SetKeybindListVisible(true)
Window:LoadConfig(snapshot)
check(toggle:GetBind().Key == 'X' and not toggle:GetBind().Visible and not state.ListVisible, 'Native config roundtrip restores key/mode/visibility')
Window:ImportKeybinds({enabledToggle = {key = 'Z', mode = 'Hold', visible = true}})
check(toggle:GetBind().Key == 'Z' and toggle:GetBind().Mode == 'Hold', 'Legacy aliases and lowercase binding fields')
Window:ImportKeybinds({later = {Key = 'L', Mode = 'Toggle'}})
local late = section:AddToggle({Name = 'Late', BindId = 'later'})
check(late:GetBind().Key == 'L', 'Bindings can load before dynamic controls exist')
check(#errors == 0, table.concat(errors, '\n'))
local root = Fatality.Windows[#Fatality.Windows]
root:Destroy()
check(state.Destroyed and state.Gui.Parent == nil and Fatality.BindingWindows[root] == nil, 'Binding lifecycle disposal')
for _, connection in ipairs(state.Connections) do check(not connection.Connected, 'Binding connection leak') end
check(#errors == 0, table.concat(errors, '\n'))
print('PASS: '..passed..' binding and nested-tab assertions')
